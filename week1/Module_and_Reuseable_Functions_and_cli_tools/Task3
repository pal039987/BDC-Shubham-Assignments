from datetime import datetime

# Reusable calculator functions
def add(a, b): return a + b
def subtract(a, b): return a - b
def multiply(a, b): return a * b
def divide(a, b): return a / b if b != 0 else 'Error: Division by zero'


# Function to write logs (from Task 2)
def write_log(message):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open("log.txt", "a") as f:
        f.write(f"[{timestamp}] {message}\n")
    print(f"Logged: {message}")


# Simulate CLI interaction
def run_calculator():
    operations = {
        "1": ("Addition", add),
        "2": ("Subtraction", subtract),
        "3": ("Multiplication", multiply),
        "4": ("Division", divide)
    }

    print("=== Simple CLI Calculator ===")
    print("1. Addition")
    print("2. Subtraction")
    print("3. Multiplication")
    print("4. Division")

    choice = input("Choose an operation (1-4): ")

    if choice not in operations:
        print("Invalid choice.")
        return

    op_name, op_func = operations[choice]

    try:
        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))
    except ValueError:
        print("Invalid number entered.")
        return

    result = op_func(a, b)
    print(f"Result: {result}")
    write_log(f"Performed {op_name.lower()}: {op_func.__name__}({a}, {b}) = {result}")


# Example usage (simulated inputs, no actual input() prompts):
print(f"add(4, 5) = {add(4, 5)}")
write_log(f"Performed addition: {add(4, 5)}")

print(f"subtract(10, 3) = {subtract(10, 3)}")
write_log(f"Performed subtraction: {subtract(10, 3)}")

print(f"multiply(6, 7) = {multiply(6, 7)}")
write_log(f"Performed multiplication: {multiply(6, 7)}")

print(f"divide(9, 0) = {divide(9, 0)}")
write_log(f"Performed division: {divide(9, 0)}")

run_calculator()