# ShopSphere Support Agent Environment Configuration
# Copy this file to .env and set your GEMINI_API_KEY before running.

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-3.8-flash

# Kill Switch: Setting to false disables auto-refunds and forces all refunds to escalate
AUTO_REFUND_ENABLED=true

# Versioning
AGENT_VERSION=v1
PROMPT_VERSION=v1

# Persistence
DB_PATH=/data/shopsphere.db
DATA_DIR=/app/shopsphere_data

# Observability (Arize Phoenix / OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:4318
TRACING_ENABLED=true
